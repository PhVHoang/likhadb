#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
RUN_ID="${LIKHADB_VERIFY_RUN_ID:-default}"
SCRATCH="/tmp/likhadb-verify-$RUN_ID"
STATE="$SCRATCH/state.env"
EVIDENCE="$ROOT/artifacts/verification/likhadb/$RUN_ID"

load_state() {
  [[ -f "$STATE" ]] || { echo "missing run state: $STATE (set LIKHADB_VERIFY_RUN_ID and launch first)" >&2; exit 1; }
  # State is generated by this helper with shell-escaped values.
  source "$STATE"
}

record_request() {
  local method="$1" path="$2" body="${3:-}" out="${4:-}"
  local args=(-sS -X "$method" -H "Authorization: Bearer $TOKEN" -w $'\nHTTP_STATUS=%{http_code}\n')
  [[ -z "$body" ]] || args+=(-H 'Content-Type: application/json' --data "$body")
  if [[ -n "$out" ]]; then
    { printf 'METHOD=%s\nPATH=%s\nBODY=%s\n' "$method" "$path" "$body"; curl "${args[@]}" "$BASE_URL$path"; } | tee "$out"
  else
    curl "${args[@]}" "$BASE_URL$path"
  fi
}

launch() {
  local http_port="${LIKHADB_VERIFY_HTTP_PORT:-18080}" grpc_port="${LIKHADB_VERIFY_GRPC_PORT:-15051}"
  [[ ! -e "$SCRATCH" ]] || { echo "scratch already exists: $SCRATCH" >&2; exit 1; }
  for port in "$http_port" "$grpc_port"; do
    [[ -z "$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)" ]] || { echo "port $port is already in use" >&2; exit 1; }
  done
  mkdir -p "$SCRATCH/data" "$EVIDENCE"
  (cd "$ROOT" && cargo build -p likhadb-server)
  local token="likhadb-verify-$RUN_ID"
  HTTP_ADDR="127.0.0.1:$http_port" GRPC_ADDR="127.0.0.1:$grpc_port" \
    LIKHADB_API_TOKEN="$token" RUST_LOG=info \
    "$ROOT/target/debug/likhadb-server" "$SCRATCH/data" >"$SCRATCH/server.log" 2>&1 &
  local pid=$!
  {
    printf 'PID=%q\n' "$pid"
    printf 'HTTP_PORT=%q\n' "$http_port"
    printf 'GRPC_PORT=%q\n' "$grpc_port"
    printf 'TOKEN=%q\n' "$token"
    printf 'BASE_URL=%q\n' "http://127.0.0.1:$http_port"
    printf 'DATA_DIR=%q\n' "$SCRATCH/data"
    printf 'BINARY=%q\n' "$ROOT/target/debug/likhadb-server"
  } >"$STATE"
  local ready=0
  for _ in {1..100}; do
    if ! kill -0 "$pid" 2>/dev/null; then tail -100 "$SCRATCH/server.log" >&2; exit 1; fi
    if rg -q 'likhadb REST listening' "$SCRATCH/server.log" && \
       [[ "$(curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $token" "http://127.0.0.1:$http_port/collections" || true)" == 200 ]]; then ready=1; break; fi
    sleep 0.1
  done
  [[ "$ready" == 1 ]] || { echo "server did not become usable" >&2; exit 1; }
  cp "$SCRATCH/server.log" "$EVIDENCE/server.log"
  echo "launched run=$RUN_ID pid=$pid url=http://127.0.0.1:$http_port evidence=$EVIDENCE"
}

doctor() {
  load_state
  kill -0 "$PID" 2>/dev/null || { echo "recorded PID $PID is not alive" >&2; exit 1; }
  local command
  command="$(ps -p "$PID" -o command=)"
  [[ "$command" == *"$BINARY"* && "$command" == *"$DATA_DIR"* ]] || { echo "PID command does not match run" >&2; exit 1; }
  [[ "$(lsof -nP -a -p "$PID" -iTCP:"$HTTP_PORT" -sTCP:LISTEN -t)" == "$PID" ]] || { echo "PID does not own HTTP port" >&2; exit 1; }
  [[ "$(lsof -nP -a -p "$PID" -iTCP:"$GRPC_PORT" -sTCP:LISTEN -t)" == "$PID" ]] || { echo "PID does not own gRPC port" >&2; exit 1; }
  [[ "$(curl -sS "$BASE_URL/health" | jq -r .status)" == ok ]] || { echo "health failed" >&2; exit 1; }
  curl -fsS -H "Authorization: Bearer $TOKEN" "$BASE_URL/collections" | jq -e '.collections | type == "array"' >/dev/null
  echo "doctor ok: run=$RUN_ID pid=$PID url=$BASE_URL data=$DATA_DIR"
}

prove_basic_search() {
  load_state
  doctor >/dev/null
  mkdir -p "$EVIDENCE"
  local initial
  initial="$(curl -fsS -H "Authorization: Bearer $TOKEN" "$BASE_URL/collections")"
  [[ "$(jq '.collections | length' <<<"$initial")" == 0 ]] || { echo "proof requires an empty collection baseline" >&2; exit 1; }
  record_request POST /collections '{"name":"docs","dim":3,"metric":"cosine"}' "$EVIDENCE/01-create.txt" >/dev/null
  record_request POST /collections/docs/vectors '{"id":1,"vector":[1,0,0],"payload":{"title":"alpha","kind":"target"}}' "$EVIDENCE/02-insert-alpha.txt" >/dev/null
  record_request POST /collections/docs/vectors '{"id":2,"vector":[0,1,0],"payload":{"title":"beta","kind":"other"}}' "$EVIDENCE/03-insert-beta.txt" >/dev/null
  record_request GET /collections/docs/vectors/1 '' "$EVIDENCE/04-get-alpha.txt" >/dev/null
  record_request POST /collections/docs/query '{"vector":[0.99,0.01,0],"k":1,"include_payload":true}' "$EVIDENCE/05-query.txt" >/dev/null
  local got query wal_size
  got="$(curl -fsS -H "Authorization: Bearer $TOKEN" "$BASE_URL/collections/docs/vectors/1")"
  query="$(curl -fsS -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' --data '{"vector":[0.99,0.01,0],"k":1,"include_payload":true}' "$BASE_URL/collections/docs/query")"
  jq -e '.id == 1 and .vector == [1,0,0] and .payload.title == "alpha"' <<<"$got" >/dev/null
  jq -e '.results | length == 1 and .[0].id == 1 and .[0].payload.title == "alpha"' <<<"$query" >/dev/null
  wal_size="$(stat -f %z "$DATA_DIR/wal.log")"
  [[ "$wal_size" -gt 0 ]] || { echo "WAL is empty" >&2; exit 1; }
  printf 'feature=vector-search\nentry_point=REST POST /collections/docs/query\nget_assertion=PASS id=1 payload.title=alpha\nquery_assertion=PASS first.id=1 first.payload.title=alpha\n' >"$EVIDENCE/assertions.txt"
  { printf 'data_dir=%s\nwal_path=%s\nwal_bytes=%s\n' "$DATA_DIR" "$DATA_DIR/wal.log" "$wal_size"; ls -la "$DATA_DIR"; } >"$EVIDENCE/persistence.txt"
  cp "$SCRATCH/server.log" "$EVIDENCE/server.log"
  echo "basic search proof passed: $EVIDENCE"
}

cleanup() {
  load_state
  mkdir -p "$EVIDENCE"
  if kill -0 "$PID" 2>/dev/null; then
    local command
    command="$(ps -p "$PID" -o command=)"
    [[ "$command" == *"$BINARY"* && "$command" == *"$DATA_DIR"* ]] || { echo "refusing to stop mismatched PID $PID" >&2; exit 1; }
    kill -TERM "$PID"
    for _ in {1..300}; do kill -0 "$PID" 2>/dev/null || break; sleep 0.1; done
    kill -0 "$PID" 2>/dev/null && { echo "PID $PID did not stop gracefully" >&2; exit 1; }
  fi
  cp "$SCRATCH/server.log" "$EVIDENCE/server.log"
  rm -rf -- "$SCRATCH"
  echo "cleaned run=$RUN_ID; evidence retained at $EVIDENCE"
}

case "${1:-}" in
  launch) launch ;;
  doctor) doctor ;;
  request) load_state; record_request "${2:?method}" "${3:?path}" "${4:-}" ;;
  prove-basic-search) prove_basic_search ;;
  cleanup) cleanup ;;
  *) echo "usage: $0 {launch|doctor|request METHOD PATH [JSON]|prove-basic-search|cleanup}" >&2; exit 2 ;;
esac
